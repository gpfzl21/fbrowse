{
  "name": "@wlalsrne/fbrowse",
  "version": "0.4.0",
  "description": "Browse large files on remote Linux servers with multi-root previews and Git tools",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "linux"
  ],
  "bin": {
    "fbrowse": "bin/fbrowse.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "examples/",
    "README.md",
    "FILE_BROWSER.md",
    "LICENSE.md",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "start": "node bin/fbrowse.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.test.cjs && node test/git-browser.test.cjs && node test/git-actions-browser.test.cjs",
    "pack:check": "npm pack --dry-run"
  },
  "license": "MIT",
  "dependencies": {
    "fflate": "0.8.3",
    "katex": "0.19.0"
  },
  "author": "wlalsrne",
  "keywords": [
    "fbrowse",
    "file-browser",
    "remote-server",
    "pdf",
    "markdown",
    "orca",
    "git"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
